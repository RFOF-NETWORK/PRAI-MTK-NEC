rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /auth_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /deterministic_tokens/{tokenId} {
      allow read, write: if true;
    }
  }
}
